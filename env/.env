VITE_APP_TITLE = '小程序项目'
VITE_APP_PORT = 9000

# uniapp  appid
VITE_UNI_APPID = 'wx916a70c50ead9b65'

# 微信小程序appid
VITE_WX_APPID = 'wx53d3ae4dca848766'

# h5部署网站的base，配置到 manifest.config.ts 里的 h5.router.base
# https://uniapp.dcloud.net.cn/collocation/manifest.html#h5-router
# 比如你要部署到 https://unibest.tech/doc/ ，则配置为 /doc/
VITE_APP_PUBLIC_BASE=/

# 后台请求地址；本机或项目专属值写入 env/.env.local
VITE_SERVER_BASEURL = ''
# 留空时使用当前域名下的相对路径；项目地址请写入 env/.env.local
# 备注：如果后台带统一前缀，则一并填写，如 https://api.example.com/api

# h5是否需要配置代理
# H5 开启代理时使用的请求前缀

# 第二个请求地址，配置多域名时使用
VITE_API_SECONDARY_URL = ''

# 认证模式，'single' | 'double' ==> 单token | 双token
VITE_AUTH_MODE = 'single'

# 静态图片地址

# 企业微信ID，按需在 env/.env.local 中配置

# 企业微信客服链接，按需在 env/.env.local 中配置
