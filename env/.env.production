# 变量必须以 VITE_ 为前缀才能暴露给外部读取
NODE_ENV = 'production'
# 是否去除console 和 debugger
VITE_DELETE_CONSOLE = false
# 是否开启sourcemap
VITE_SHOW_SOURCEMAP = false

# 生产环境后台请求地址；项目专属值写入 env/.env.production.local
VITE_SERVER_BASEURL = ''
# 留空时使用当前域名下的相对路径；生产项目地址请写入 env/.env.production.local

# 生产环境静态图片地址；项目专属值写入 env/.env.production.local
